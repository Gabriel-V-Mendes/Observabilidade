# ==============================================================================
# Variáveis de Ambiente — Stack de Observabilidade & SLOs
# Copie para `.env` se desejar sobrescrever os valores padrão em ambiente local.
# NUNCA faça commit de webhooks ou senhas reais no Git.
# ==============================================================================

# Credenciais do Grafana (apenas desenvolvimento local)
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# Parâmetros da API
APP_NAME=observability-api
APP_VERSION=2.0.0
LOG_LEVEL=INFO

# Integrações opcionais do Alertmanager (Slack / Discord / SMTP)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/placeholder
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/0000000000/placeholder
